# B-04: why xcodebuild cannot install the runner, and the fix. iPhone XS (iOS 18.7.3): A, B1 and the runner installed
# The message is CoreDevice's, not Xcode's: the system framework both Xcodes load (27.0 installed it)
$ strings /Library/Developer/PrivateFrameworks/CoreDevice.framework/Versions/A/CoreDevice | grep -E 'Root install style|Installation of item at'
Installation of item at %s will use application install style
Root install style is not supported on this device
$ plutil -extract CFBundleVersion raw /Library/Developer/PrivateFrameworks/CoreDevice.framework/Versions/A/Resources/Info.plist
642.16

# XCTHarness chooses the internal (root/rsync) install style when the .xctestrun names a DSTROOT
$ strings /Applications/Xcode.app/Contents/SharedFrameworks/XCTHarness.framework/Versions/A/XCTHarness | grep -E 'DSTROOTPath|useInternalOrRsyncInstallStyle'
DSTROOTPath
useInternalOrRsyncInstallStyle

# The runner installs by hand (devicectl) without complaint
$ xcrun devicectl device install app --device 00008020-000A6CC42692002E HarnessUITests-Runner.app  -> App installed: io.github.youndie.iosbench.harness.xctrunner

